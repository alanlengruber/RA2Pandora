+/* Copies a core frame into a page rotated by rot * 90 degrees
+ * counter-clockwise (the libretro convention). w, h and pitch
+ * describe the source frame. */
+static void drm_blit_rotated(struct modeset_buf *dst, const uint8_t *src,
+      unsigned w, unsigned h, unsigned pitch, unsigned bpp, unsigned rot)
+{
+   unsigned x, y;
+   unsigned dw = (rot & 1) ? h : w;
+   unsigned dh = (rot & 1) ? w : h;
+
+   for (y = 0; y < dh; y++)
+   {
+      uint8_t *d = dst->map + y * dst->stride;
+
+      for (x = 0; x < dw; x++)
+      {
+         unsigned sx, sy;
+
+         switch (rot)
+         {
+            case 1:  sx = w - 1 - y; sy = x;         break;
+            case 2:  sx = w - 1 - x; sy = h - 1 - y; break;
+            default: sx = y;         sy = h - 1 - x; break;
+         }
+
+         if (bpp == 4)
+            ((uint32_t*)d)[x] = *(const uint32_t*)(src + sy * pitch + sx * 4);
+         else
+            ((uint16_t*)d)[x] = *(const uint16_t*)(src + sy * pitch + sx * 2);
+      }
+   }
+}
