+/* On-screen text (RetroArch notifications, such as achievement unlocks):
+ * this driver has no font renderer or widgets, so messages are drawn with
+ * the bitmap font on a black band at the top or bottom of the frame. */
+#define DRM_MSG_MAX_LINES 4
+#define DRM_MSG_MAX_COLS  96
+
+static bitmapfont_lut_t *drm_font = NULL;
+
+static void drm_put_pixel(struct modeset_buf *buf, unsigned bpp,
+      int x, int y, bool on)
+{
+   uint8_t *row = buf->map + y * buf->stride;
+
+   if (bpp == 4)
+      ((uint32_t*)row)[x] = on ? 0x00FFFFFF : 0;
+   else
+      ((uint16_t*)row)[x] = on ? 0xFFFF : 0;
+}
+
+/* UTF-8 to plain ASCII: the bitmap font only has ASCII. Accented Latin
+ * letters lose the accent, anything else becomes '?'. */
+static void drm_msg_to_ascii(const char *in, char *out, size_t size)
+{
+   static const char latin1[] =
+      "AAAAAAACEEEEIIII" "DNOOOOOxOUUUUYPs"  /* U+00C0..U+00DF */
+      "aaaaaaaceeeeiiii" "dnooooo/ouuuuypy"; /* U+00E0..U+00FF */
+   const unsigned char *p = (const unsigned char*)in;
+   size_t n = 0;
+
+   while (*p && n + 1 < size)
+   {
+      unsigned c = *p++;
+
+      if (c < 0x80)
+         out[n++] = (c < 0x20) ? ' ' : (char)c;
+      else if ((c & 0xE0) == 0xC0 && (*p & 0xC0) == 0x80)
+      {
+         unsigned cp = ((c & 0x1F) << 6) | (*p++ & 0x3F);
+         out[n++] = (cp >= 0xC0 && cp <= 0xFF) ? latin1[cp - 0xC0] : '?';
+      }
+      else
+      {
+         /* Longer sequence: skip its continuation bytes. */
+         while ((*p & 0xC0) == 0x80)
+            p++;
+         out[n++] = '?';
+      }
+   }
+   out[n] = '\0';
+}
+
+static void drm_draw_msg(struct drm_surface *surface, const char *msg)
+{
+   struct modeset_buf *buf = &surface->pages[surface->flip_page].buf;
+   int w = surface->src_width, h = surface->src_height;
+   int cols = (w - 4) / FONT_WIDTH_STRIDE;
+   char text[512], lines[DRM_MSG_MAX_LINES][DRM_MSG_MAX_COLS + 1];
+   int nlines = 0, len = 0, i, band_h, y0;
+   char *word, *save = NULL;
+
+   if (!msg || !*msg || cols < 4)
+      return;
+   if (cols > DRM_MSG_MAX_COLS)
+      cols = DRM_MSG_MAX_COLS;
+   if (!drm_font && !(drm_font = bitmapfont_get_lut()))
+      return;
+
+   /* Word wrap into at most DRM_MSG_MAX_LINES lines; a word longer than a
+    * whole line is split. */
+   drm_msg_to_ascii(msg, text, sizeof(text));
+   lines[0][0] = '\0';
+   for (word = strtok_r(text, " ", &save); word; word = strtok_r(NULL, " ", &save))
+   {
+      int wlen = (int)strlen(word);
+
+      while (wlen > 0 && nlines < DRM_MSG_MAX_LINES)
+      {
+         int take;
+
+         if (len > 0 && len + 1 + wlen > cols)
+         {
+            /* Does not fit after the current text: next line. */
+            if (++nlines < DRM_MSG_MAX_LINES)
+               lines[nlines][0] = '\0';
+            len = 0;
+            continue;
+         }
+         if (len > 0)
+            lines[nlines][len++] = ' ';
+         take = wlen < cols ? wlen : cols;
+         memcpy(lines[nlines] + len, word, take);
+         len += take;
+         lines[nlines][len] = '\0';
+         word += take;
+         wlen -= take;
+      }
+   }
+   if (nlines < DRM_MSG_MAX_LINES && len > 0)
+      nlines++;
+   if (!nlines)
+      return;
+
+   /* Band at the top or the bottom of the frame, following RetroArch's
+    * message position (video_message_pos_y, measured from the bottom). */
+   band_h = nlines * FONT_HEIGHT_STRIDE + 3;
+   if (band_h > h)
+      return;
+   y0 = (config_get_ptr()->floats.video_msg_pos_y >= 0.5f) ? 0 : h - band_h;
+
+   for (i = y0; i < y0 + band_h; i++)
+   {
+      int x;
+      for (x = 0; x < w; x++)
+         drm_put_pixel(buf, surface->bpp, x, i, false);
+   }
+
+   for (i = 0; i < nlines; i++)
+   {
+      int n  = (int)strlen(lines[i]);
+      int x0 = (w - n * FONT_WIDTH_STRIDE) / 2;
+      int ly = y0 + 2 + i * FONT_HEIGHT_STRIDE;
+      int k, gx, gy;
+
+      for (k = 0; k < n; k++)
+      {
+         const bool *glyph = drm_font->lut[(unsigned char)lines[i][k]];
+
+         for (gy = 0; gy < FONT_HEIGHT; gy++)
+            for (gx = 0; gx < FONT_WIDTH; gx++)
+               if (glyph[gx + gy * FONT_WIDTH])
+                  drm_put_pixel(buf, surface->bpp,
+                        x0 + k * FONT_WIDTH_STRIDE + gx, ly + gy, true);
+      }
+   }
+}
