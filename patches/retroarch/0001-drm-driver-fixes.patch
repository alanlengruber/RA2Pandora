+/* Page flips are non-blocking: a blocking atomic commit on the Rockchip
+ * 4.4 kernel only returns two vblanks later, halving the frame rate.
+ * We only wait for the previous flip before queueing the next one. */
+static bool drm_flip_pending = false;
+
+static void drm_flip_handler(int fd, unsigned frame,
+      unsigned sec, unsigned usec, void *data)
+{
+   drm_flip_pending = false;
+}
+
+static void drm_wait_pending_flip(void)
+{
+   drmEventContext evctx = {0};
+   evctx.version           = 2;
+   evctx.page_flip_handler = drm_flip_handler;
+
+   while (drm_flip_pending)
+   {
+      struct pollfd pfd = { drm.fd, POLLIN, 0 };
+      /* Never hang on a lost event. */
+      if (poll(&pfd, 1, 100) <= 0)
+      {
+         drm_flip_pending = false;
+         break;
+      }
+      drmHandleEvent(drm.fd, &evctx);
+   }
+}
